{
  "services": {
    "web": {
      "root": ".",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    }
  },
  "installCommand": "pip install -r requirements.txt",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "src": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
