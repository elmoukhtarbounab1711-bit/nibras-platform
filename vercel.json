{
  "version": 2,
  "framework": "python",
  "installCommand": "pip install -r deps.txt",
  "functions": {
    "wsgi.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/auth/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=60" }
      ]
    }
  ]
}
