{
  "version": 2,
  "outputDirectory": "frontend",
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "src": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
