{
  "version": 2,
  "outputDirectory": "frontend",
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "runtime": "@vercel/python"
    }
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin(.*)",
      "destination": "/admin.html"
    },
    {
      "src": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
