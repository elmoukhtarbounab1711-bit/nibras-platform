# نبراس — نموذج متغيرات البيئة للإنتاج (PaaS)
# انسخ إلى .env أو ضعه كمتغيرات في لوحة التحكم. لا ترفع قيمًا حقيقية إلى git.
# كل مفتاح هنا اختياري إلا NIBRAS_JWT_SECRET الذي إلزامي ثابت.

# --- الأساسيات ----------------------------------------------------------------
NIBRAS_DEBUG=0
# سر توقيع JWT — إلزامي ثابت في الإنتاج (بدونه تنتهي الجلسات عند كل إقلاع).
NIBRAS_JWT_SECRET=غيّر-هذا-بسر-طويل-وعشوائي-جدا-1234567890
# النطاقات المسموح لها بالاتصال بالـ API — مفصولة بفواصل. "*" للسماح للكل.
NIBRAS_CORS_ORIGINS=*
# رابط الواجهة لبناء روابط استعادة كلمة المرور المرسلة بالبريد.
NIBRAS_FRONTEND_BASE_URL=https://nibras.onrender.com

# --- قاعدة البيانات (SQLite على قرص مُثبَّت) ---------------------------------
# PaaS لها نظام ملفات عابر — ضع القاعدة على قرص مُثبَّت (Disk/Volume).
NIBRAS_DB_PATH=/data/nibras.db
# مجلد رفع وثائق التحقق والقوالب — على القرص المُثبَّت أيضًا.
NIBRAS_UPLOAD_DIR=/data/uploads

# --- الذكاء الاصطناعي (اختياري — noop للتطوير فقط) ---------------------------
# مزوّدات Gemini/Groq/OpenRouter تُدار من لوحة التحكم (جدول ai_providers) —
# لا تُضبط ببيئة. يُضبط بالبيئة فقط احتياطي Anthropic:
# NIBRAS_AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# NIBRAS_AI_MODEL=claude-sonnet-4-5
# NIBRAS_AI_RETRIEVAL_LIMIT=12
# NIBRAS_AI_JURISPRUDENCE_LIMIT=5
# NIBRAS_AI_WEBSEARCH_LIMIT=5

# --- السجلات ------------------------------------------------------------------
NIBRAS_LOG_LEVEL=INFO
NIBRAS_LOG_FORMAT=json
NIBRAS_LOG_ACCESS=1
NIBRAS_APP_VERSION=1.0.0

# --- خط PDF عربي (اختياري — حل تلقائي على لينكس عبر Noto/Amiri) --------------
# NIBRAS_PDF_FONT=/usr/share/fonts/truetype/noto/NotoNaskhArabic-Regular.ttf